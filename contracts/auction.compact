// Gavel sealed-bid auction contract. One contract instance per auction
// (the frontend deploys a new instance per seller listing; there is no
// on-chain registry of auctions here — that is an indexer/off-chain
// concern). Mechanism is the settlement-window rolling maximum decided in
// PLAN.md section 4, promoted from contracts/phase0-spike/settlement.compact
// with deadline enforcement (blockTimeLt/blockTimeGte, confirmed available
// in CompactStandardLibrary via docs.midnight.network) and a seller-set
// minimum bid increment added.

pragma language_version >= 0.23;

import CompactStandardLibrary;

export enum AuctionState {
  Created,
  Bidding,
  SettlementWindow,
  Settled,
  Cancelled
}

export ledger state: AuctionState;
export ledger sellerId: Bytes<32>;
export ledger minBid: Uint<64>;
export ledger minIncrement: Uint<64>;
export ledger biddingDeadline: Uint<64>;
export ledger settlementDeadline: Uint<64>;
export ledger bidCount: Counter;

// One nullifier per wallet per auction (one active bid per wallet, PLAN.md
// section 4 bidding rules) without linking the nullifier to a wallet address.
export ledger nullifiers: Set<Bytes<32>>;

// bidderId -> commitment to (amount, nonce). Only the commitment is ever
// stored during Bidding; the amount itself never touches the ledger here.
export ledger commitments: Map<Bytes<32>, Bytes<32>>;

// Rolling maximum during the settlement window. currentMaxAmount stays 0
// (and currentLeaderId unset) until the first bidder settles above minBid.
// This sentinel is only sound because the constructor requires minBid > 0,
// so no valid settled amount can ever equal 0 and collide with "no leader".
export ledger currentMaxAmount: Uint<64>;
export ledger currentLeaderId: Bytes<32>;
export ledger settled: Set<Bytes<32>>;
export ledger winnerAddress: Bytes<32>;

constructor(
  seller: Bytes<32>,
  bidFloor: Uint<64>,
  bidIncrement: Uint<64>,
  biddingEndsAt: Uint<64>,
  settlementEndsAt: Uint<64>
) {
  // Input verification checks (same assert-in-constructor pattern as the
  // official example-battleship contract's constructor).
  //
  // bidFloor > 0: settleBid uses currentMaxAmount == 0 as the "no leader
  // yet" sentinel. Every settled bid must satisfy amount >= minBid, so a
  // strictly positive floor guarantees no valid bid amount can ever equal
  // the sentinel. With bidFloor == 0 a second bidder settling with
  // amount == 0 would re-enter the "first bid" branch and overwrite an
  // earlier equal leader, breaking "highest bid wins" (PLAN.md section 4).
  assert(bidFloor > 0, "Bid floor must be greater than zero");
  // bidIncrement > 0: settleBid's tie handling is "first bidder to reach a
  // given amount keeps leadership" (an equal amount must NOT clear
  // currentMaxAmount + minIncrement). A zero increment would let a later
  // equal settle displace an earlier equal leader, contradicting that
  // invariant (see the tie-handling scenario in scripts/auction-check.ts).
  assert(bidIncrement > 0, "Bid increment must be greater than zero");
  // settlementEndsAt > biddingEndsAt: otherwise closeBidding can move the
  // auction into SettlementWindow while settleBid's
  // blockTimeLt(settlementDeadline) is already false, so nobody can ever
  // settle and finalizeSettlement can never have a leader to finalize —
  // the auction locks permanently with no recovery circuit.
  assert(settlementEndsAt > biddingEndsAt,
         "Settlement deadline must be after the bidding deadline");

  sellerId = disclose(seller);
  minBid = disclose(bidFloor);
  minIncrement = disclose(bidIncrement);
  biddingDeadline = disclose(biddingEndsAt);
  settlementDeadline = disclose(settlementEndsAt);
  state = AuctionState.Created;
}

// Per-wallet secret, supplied from local private state by the TS driver.
// Never appears on-chain except hashed through the two derive circuits.
witness localSecretKey(): Bytes<32>;

export circuit deriveBidderId(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "gavel:bidder-id:"), sk]);
}

export circuit deriveNullifier(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "gavel:nullifier:"), sk]);
}

// Exposed so the off-chain driver can build a commitment client-side before
// calling submitBid — the same hash the circuit checks internally in
// settleBid, never computed by TS from scratch.
export circuit computeCommitment(amount: Uint<64>, nonce: Bytes<32>): Bytes<32> {
  return persistentCommit<Uint<64>>(amount, nonce);
}

export circuit openBidding(): [] {
  assert(state == AuctionState.Created, "Auction is not in Created state");
  // Only the seller starts their own auction. sellerId was set at
  // construction to deriveBidderId(seller's secret); proving knowledge of
  // that secret is the same ownership check finalizeSettlement uses on the
  // leader. closeBidding/cancelAuction stay open on purpose: gating them on
  // the seller would let an absent seller permanently strand a settled or
  // zero-bid auction, and both are already guarded by state/deadline/count.
  assert(deriveBidderId(localSecretKey()) == sellerId, "Only the seller can open bidding");
  state = AuctionState.Bidding;
}

// commitment = persistentCommit<Uint<64>>(amount, nonce), computed
// client-side before calling this circuit.
export circuit submitBid(commitment: Bytes<32>): [] {
  assert(state == AuctionState.Bidding, "Auction is not accepting bids");
  assert(blockTimeLt(biddingDeadline), "Bidding deadline has passed");
  // Shill-bidding guard: the seller cannot bid on their own auction. Same
  // ownership derivation as openBidding, negated.
  assert(deriveBidderId(localSecretKey()) != sellerId, "Seller cannot bid on their own auction");
  const nul = deriveNullifier(localSecretKey());
  assert(!nullifiers.member(disclose(nul)), "This wallet already has an active bid");
  const bidderId = deriveBidderId(localSecretKey());
  nullifiers.insert(disclose(nul));
  commitments.insert(disclose(bidderId), disclose(commitment));
  bidCount.increment(1);
}

export circuit closeBidding(): [] {
  assert(state == AuctionState.Bidding, "Auction is not in Bidding state");
  assert(blockTimeGte(biddingDeadline), "Bidding deadline has not passed yet");
  assert(bidCount > 0, "Cannot close an auction with zero bids");
  state = AuctionState.SettlementWindow;
}

// Zero-bid auctions never enter settlement; the seller (or anyone, since
// there is nothing to grief) can free the contract's Created/Bidding state.
export circuit cancelAuction(): [] {
  assert(state == AuctionState.Bidding, "Auction is not in Bidding state");
  assert(blockTimeGte(biddingDeadline), "Bidding deadline has not passed yet");
  assert(bidCount == 0, "Auction has bids, cannot cancel");
  state = AuctionState.Cancelled;
}

// Bidder opens their own commitment in-circuit. amount/nonce are ordinary
// (private) circuit arguments, never disclosed unless this bidder becomes
// the new leader — the only conditional disclosure in this contract.
export circuit settleBid(amount: Uint<64>, nonce: Bytes<32>): [] {
  assert(state == AuctionState.SettlementWindow, "Not in settlement window");
  assert(blockTimeLt(settlementDeadline), "Settlement window has closed");
  const bidderId = deriveBidderId(localSecretKey());
  assert(!settled.member(disclose(bidderId)), "Already settled");
  const stored = commitments.lookup(disclose(bidderId));
  assert(persistentCommit<Uint<64>>(amount, nonce) == stored,
         "Amount/nonce do not match stored commitment");
  assert(amount >= minBid, "Bid below auction floor");

  settled.insert(disclose(bidderId));

  // The comparison result itself must be disclosed before it can gate a
  // ledger write — otherwise the write's occurrence would leak the boolean
  // outcome of a witness-value comparison without an explicit disclosure.
  const isFirstBid = currentMaxAmount == 0;
  const clearsFloor = isFirstBid && amount >= minBid;
  const clearsIncrement = !isFirstBid && amount >= currentMaxAmount + minIncrement;
  const isNewMax = disclose(clearsFloor || clearsIncrement);
  if (isNewMax) {
    currentMaxAmount = disclose(amount);
    currentLeaderId = disclose(bidderId);
  }
}

// Called by the current leader once no higher settlement is expected.
// Proves ownership of the leader id, then discloses the address the leader
// wants recorded as the public winner.
export circuit finalizeSettlement(claimedAddress: Bytes<32>): [] {
  assert(state == AuctionState.SettlementWindow, "Not in settlement window");
  assert(blockTimeGte(settlementDeadline), "Settlement window is still open");
  const bidderId = deriveBidderId(localSecretKey());
  assert(bidderId == currentLeaderId, "Caller is not the recorded leader");
  winnerAddress = disclose(claimedAddress);
  state = AuctionState.Settled;
}
